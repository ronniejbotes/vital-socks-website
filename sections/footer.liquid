{%- liquid
  assign socials = 'instagram,tiktok,facebook,youtube,linkedin' | split: ','
-%}
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}">
          {%- if settings.logo_inverse != blank -%}
            {{ settings.logo_inverse | image_url: width: 380 | image_tag: alt: shop.name, width: 190 }}
          {%- else -%}
            <img
              src="{{ 'vital-socks-logo-white.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="190"
              height="80"
              loading="lazy"
            >
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        <div class="footer__social">
          {%- for network in socials -%}
            {%- assign key = 'social_' | append: network -%}
            {%- assign network_name = network | capitalize -%}
            {%- if settings[key] != blank -%}
              <a
                class="icon-btn"
                href="{{ settings[key] }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'general.social.label' | t: network: network_name }}"
              >
                {% render 'icon', name: network, size: 20 %}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign menu = linklists[block.settings.menu] -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <p class="footer__heading">{{ block.settings.heading | escape }}</p>
              <ul class="footer__links" role="list">
                {%- for link in menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'contact' -%}
            {%- if settings.contact_email == blank and settings.contact_phone == blank and block.settings.text == blank -%}
              {%- continue -%}
            {%- endif -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <p class="footer__heading">{{ block.settings.heading | escape }}</p>
              <ul class="footer__links" role="list">
                {%- if settings.contact_email != blank -%}
                  <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
                {%- endif -%}
                {%- if settings.contact_phone != blank -%}
                  <li>
                    <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a>
                  </li>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <li class="footer__tagline">{{ block.settings.text }}</li>
                {%- endif -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__legal">
      {%- if section.settings.disclaimer != blank -%}
        <div class="footer__disclaimer">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ settings.legal_name | default: shop.name }}
        {%- if settings.registration_number != blank %} &middot; Reg. {{ settings.registration_number }}{% endif -%}
        {%- if settings.vat_number != blank %} &middot; VAT {{ settings.vat_number }}{% endif -%}
      </p>
      {%- if settings.address != blank -%}
        <p>{{ settings.address | newline_to_br | replace: '<br />', ', ' | strip_newlines }}</p>
      {%- endif -%}
      {%- if settings.contact_email != blank or settings.contact_phone != blank -%}
        <p>
          {%- if settings.contact_email != blank -%}
            <a href="mailto:{{ settings.contact_email | strip }}">{{ settings.contact_email | escape }}</a>
          {%- endif -%}
          {%- if settings.contact_email != blank and settings.contact_phone != blank %} &middot; {% endif -%}
          {%- if settings.contact_phone != blank -%}
            <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone | escape }}</a>
          {%- endif -%}
        </p>
      {%- endif -%}
      <p>
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- unless forloop.last %} &middot; {% endunless -%}
        {%- endfor -%}
      </p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.wordmark != blank -%}
    <p class="footer__wordmark" aria-hidden="true" data-parallax-text>{{ section.settings.wordmark | escape }}</p>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Everyday compression socks from a South African brand."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "info": "Shown on every page.",
      "default": "<p>This product is designed for everyday compression and is not intended for diagnosed medical conditions requiring therapeutic compression. If you have a medical condition or persistent swelling, please consult an Orthotist or healthcare professional. Our Orthotist is available for guidance at <a href=\"https://www.cajeebotes.com\">www.cajeebotes.com</a></p>"
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "wordmark", "label": "Large outlined word", "default": "Vital" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" },
        { "type": "richtext", "id": "text", "label": "Extra text" }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
