<div class="page-hero container{% if section.settings.narrow %} container--narrow{% endif %}">
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
      <li aria-current="page">{{ page.title | escape }}</li>
    </ol>
  </nav>
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
  <h1 class="h1 page-hero__title">{{ page.title | escape }}</h1>
</div>
{%- if page.content != blank -%}
  <div class="page-body container{% if section.settings.narrow %} container--narrow{% endif %} section--tight" style="padding-top: 0;">
    <div class="rte">{{ page.content }}</div>
  </div>
{%- endif -%}

{%- comment -%} Breadcrumb markup lives beside the visible trail above, so the two always match. {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
    ]
  }
</script>

{% schema %}
{
  "name": "Page content",
  "class": "section-main-page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow reading width",
      "info": "Untick to line the title up with full-width sections below it. Page text keeps a comfortable reading width either way.",
      "default": true
    }
  ]
}
{% endschema %}
