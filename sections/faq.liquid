{%- comment -%}
  FAQ accordion (native <details>) plus FAQPage structured data built from the
  same blocks, so the visible answers and the markup can never drift apart.
{%- endcomment -%}
<section class="faq section" aria-labelledby="FaqHeading-{{ section.id }}">
  <div class="container faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="h2" id="FaqHeading-{{ section.id }}" data-reveal>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            {% render 'icon', name: 'plus', size: 22 %}
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compression, answered" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Not sure which pair or size you need? Ask us and we'll point you to the right one.</p>"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Add FAQ structured data",
      "info": "Use on one page only. Search engines ignore duplicate FAQ markup.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What does graduated compression mean?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>The sock is firmest at the ankle and gradually lighter up the leg.</p>" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
