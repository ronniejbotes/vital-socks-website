<section class="not-found tone-royal" style="min-height: 100svh;">
  {% render 'ribbons' %}
  <div class="container not-found__inner" style="max-width: 640px;">
    <img src="{{ 'vital-socks-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="260" height="110" style="margin: 0 auto 32px;">
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lede" style="margin-inline: auto; color: #fff;">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordEmail">{{ 'sections.newsletter.email' | t }}</label>
        <input class="input" id="PasswordEmail" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.email' | t }}">
        <button class="btn btn--ink" type="submit">{{ 'sections.newsletter.subscribe' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top: 40px;">
      <summary>Store owner? Enter the password</summary>
      {%- form 'storefront_password', class: 'newsletter__form' -%}
        <label class="visually-hidden" for="StorePassword">Password</label>
        <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" required>
        <button class="btn btn--light" type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Graded compression is nearly here" }]
}
{% endschema %}
