{%- comment -%}
  A photo beside composed copy. The copy column is built from blocks:
  eyebrow, heading, text, a row of pills (items separated by · or commas),
  a display tagline and a button. With no image chosen, a bundled photo can
  be shown. [compression] in text blocks shows the compression level of the
  product chosen in Theme settings > Compression; if that level is blank, the
  paragraph holding the token is hidden.
{%- endcomment -%}
{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_image = false
  if section.settings.image != blank or section.settings.bundled != 'none'
    assign has_image = true
  endif
-%}
<section class="image-text section tone-{{ section.settings.tone }} image-text--{{ section.settings.layout }}{% unless has_image %} image-text--no-media{% endunless %}">
  <div class="container image-text__grid">
    {%- if has_image -%}
      <div class="image-text__media" data-reveal>
        {%- if section.settings.image != blank -%}
          {%- assign media_alt = section.settings.image.alt | default: section.settings.image_alt -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 900px) 42vw, 100vw',
              loading: 'lazy',
              alt: media_alt
          }}
        {%- else -%}
          {%- assign md = 'iwt-' | append: section.settings.bundled | append: '-md.webp' -%}
          {%- assign lg = 'iwt-' | append: section.settings.bundled | append: '.webp' -%}
          <img
            src="{{ lg | asset_url }}"
            srcset="{{ md | asset_url }} 800w, {{ lg | asset_url }} 1200w"
            sizes="(min-width: 900px) 42vw, 100vw"
            width="1200"
            height="1489"
            loading="lazy"
            alt="{{ section.settings.image_alt | escape }}"
          >
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="image-text__copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="h2 image-text__heading" {{ block.shopify_attributes }} data-reveal>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- capture body -%}{% render 'compression-text', text: block.settings.text %}{%- endcapture -%}
            {%- if body != blank -%}
              <div class="lede rte image-text__text" {{ block.shopify_attributes }}>{{ body }}</div>
            {%- endif -%}
          {%- when 'pills' -%}
            {%- if block.settings.items != blank -%}
              {%- assign items = block.settings.items | replace: ',', '·' | split: '·' -%}
              <ul class="image-text__pills" role="list" {{ block.shopify_attributes }} data-reveal>
                {%- for item in items -%}
                  {%- assign label = item | strip -%}
                  {%- if label != blank -%}
                    <li class="image-text__pill">
                      <span class="image-text__dot" aria-hidden="true"></span>
                      {{- label | escape -}}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- when 'tagline' -%}
            {%- if block.settings.text != blank -%}
              <p class="image-text__tagline" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <div class="image-text__actions" {{ block.shopify_attributes }}>
                <a class="btn{% if block.settings.style == 'ghost' %} btn--ghost{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                  {{- block.settings.label | escape -}}
                  {% render 'icon', name: 'arrow-right', size: 18 %}
                </a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "frost", "label": "Frost blue" },
        { "value": "ice", "label": "Ice blue" },
        { "value": "ink", "label": "Navy" }
      ],
      "default": "frost"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-left"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "bundled",
      "label": "Bundled photo when no image is chosen",
      "options": [
        { "value": "materials-daisy", "label": "Daisy knit close-up" },
        { "value": "none", "label": "None" }
      ],
      "default": "materials-daisy"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description for screen readers",
      "info": "Used for the bundled photo, and for an uploaded image that has no alt text.",
      "default": "Close-up of the knitted fabric of a Daisy knee-high compression sock with the Vital Socks logo on its purple cuff"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading" }]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "[compression] shows the compression level from Theme settings > Compression."
        }
      ]
    },
    {
      "type": "pills",
      "name": "Pills",
      "settings": [
        {
          "type": "text",
          "id": "items",
          "label": "Items",
          "info": "Separate items with · or commas."
        }
      ]
    },
    {
      "type": "tagline",
      "name": "Tagline",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all socks" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "ghost", "label": "Outline" }
          ],
          "default": "solid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "eyebrow", "settings": { "text": "Material composition" } },
        { "type": "heading", "settings": { "heading": "Comfort in every thread." } },
        {
          "type": "text",
          "settings": {
            "text": "<p>Made with a carefully selected blend of <strong>combed cotton, polyamide and elastane</strong> for a soft feel, comfortable stretch and lasting wear.</p>"
          }
        },
        { "type": "pills", "settings": { "items": "Combed cotton · Polyamide · Elastane" } },
        { "type": "tagline", "settings": { "text": "Soft. Comfortable. Made to move." } }
      ]
    }
  ]
}
{% endschema %}
