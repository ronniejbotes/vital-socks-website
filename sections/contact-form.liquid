<section class="section" aria-labelledby="ContactHeading-{{ section.id }}">
  <div class="container container--narrow">
    <h2 class="h2" id="ContactHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="lede" style="margin-bottom: 32px;">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'sections.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-message form-message--error" role="alert">{{ 'sections.contact.error' | t }}</p>
      {%- endif -%}
      <div class="field">
        <label for="ContactName">{{ 'sections.contact.name' | t }}</label>
        <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">{{ 'sections.contact.email' | t }}</label>
        <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="field">
        <label for="ContactPhone">{{ 'sections.contact.phone' | t }}</label>
        <input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="field">
        <label for="ContactBody">{{ 'sections.contact.message' | t }}</label>
        <textarea id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
      </div>
      {%- if section.settings.consent_label != blank -%}
        <div class="field-check">
          <input id="ContactHealthConsent" type="checkbox" name="contact[health_consent]" value="{{ 'sections.contact.consent_given' | t }}">
          <label for="ContactHealthConsent">{{ section.settings.consent_label | escape }}</label>
        </div>
      {%- endif -%}
      {%- if section.settings.privacy_text != blank -%}
        <p class="legal-note">{% render 'policy-links', text: section.settings.privacy_text %}</p>
      {%- endif -%}
      <button class="btn" type="submit">{{ 'sections.contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ask us anything" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sizing question or help with an order? Send us a message.</p>" },
    {
      "type": "text",
      "id": "consent_label",
      "label": "Health details consent checkbox",
      "info": "Optional and unticked. Leave blank to hide the checkbox.",
      "default": "I consent to Vital Socks using any health details I include in this message to answer my question."
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy notice",
      "info": "Shown above the send button. \"Privacy policy\" links to that policy when it exists.",
      "default": "We use your details only to answer your message. See our Privacy policy."
    }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
