{%- comment -%}
  "You might also like", filled by Shopify's Product Recommendations API.
  theme.js fetches this section with the product id and swaps the result in.
{%- endcomment -%}
<product-recommendations
  class="related section"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head">
        <h2 class="h2 section-head__title">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="product-grid" role="list" style="--cols: {{ section.settings.limit }};">
        {%- for rec in recommendations.products -%}
          <li>{% render 'product-card', product: rec, index: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pair it with" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 4, "step": 1, "default": 4 }
  ]
}
{% endschema %}
