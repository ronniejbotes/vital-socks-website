{%- liquid
  assign align = section.settings.align
  assign justify = 'center'
  assign lede_margin = 'auto'
  if align == 'left'
    assign justify = 'flex-start'
    assign lede_margin = '0'
  endif
-%}
<section
  class="rich-text section tone-{{ section.settings.tone }}{% if section.settings.tight %} section--tight{% endif %}"
  style="--align: {{ align }}; --justify: {{ justify }}; --lede-margin: {{ lede_margin }};"
>
  <div class="container container--narrow">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          {%- assign tag = block.settings.tag -%}
          <{{ tag }} class="{{ block.settings.size }}" {{ block.shopify_attributes }} data-reveal>{{ block.settings.heading | escape }}</{{ tag }}>
        {%- when 'text' -%}
          <div class="lede rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <div class="rich-text__actions" {{ block.shopify_attributes }}>
              <a class="btn{% if block.settings.style == 'ghost' %} btn--ghost{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                {{- block.settings.label | escape -}}
                {% render 'icon', name: 'arrow-right', size: 18 %}
              </a>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "frost", "label": "Frost" },
        { "value": "ice", "label": "Ice blue" },
        { "value": "sky", "label": "Sky blue" },
        { "value": "royal", "label": "Royal blue" },
        { "value": "ink", "label": "Navy" }
      ],
      "default": "paper"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "tight", "label": "Less spacing", "default": false }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Eyebrow" }] },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Say something useful" },
        {
          "type": "select",
          "id": "tag",
          "label": "Level",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "display", "label": "Giant" },
            { "value": "h1", "label": "Large" },
            { "value": "h2", "label": "Medium" },
            { "value": "h3", "label": "Small" }
          ],
          "default": "h2"
        }
      ]
    },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story in a sentence or two.</p>" }] },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the prints" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "ghost", "label": "Outline" }
          ],
          "default": "solid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }]
    }
  ]
}
{% endschema %}
