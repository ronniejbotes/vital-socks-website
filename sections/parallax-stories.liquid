{%- comment -%}
  Full-bleed story panels. Each photo is taller than its panel and motion.js
  slides it more slowly than the page, so the background drifts as you scroll.
  Text sits on the photo's empty side over a navy scrim for contrast.
{%- endcomment -%}
{{ 'section-stories.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign head_media = false
  if section.settings.head_image != blank or section.settings.head_bundled != 'none'
    assign head_media = true
  endif
  assign head_copy = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign head_copy = true
  endif
-%}
<section
  class="stories"
  {% if section.settings.heading != blank %}
    aria-labelledby="StoriesHeading-{{ section.id }}"
  {% endif %}
>
  {%- comment -%} With no eyebrow, heading, intro or photo, the intro band is left out and the panels start straight away. {%- endcomment -%}
  {%- if head_copy or head_media -%}
    <div class="container stories__head{% if head_media %} stories__head--media{% endif %}">
      {%- if head_copy -%}
        <div class="stories__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2 stories__title" id="StoriesHeading-{{ section.id }}" data-reveal>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="lede">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if head_media -%}
        <div class="stories__head-media" data-reveal>
          {%- if section.settings.head_image != blank -%}
            {%- assign head_alt = section.settings.head_image.alt | default: section.settings.head_alt -%}
            {{
              section.settings.head_image
              | image_url: width: 1600
              | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: head_alt
            }}
          {%- else -%}
            {%- assign head_md = 'stories-' | append: section.settings.head_bundled | append: '-md.webp' -%}
            {%- assign head_lg = 'stories-' | append: section.settings.head_bundled | append: '.webp' -%}
            <img
              src="{{ head_lg | asset_url }}"
              srcset="{{ head_md | asset_url }} 900w, {{ head_lg | asset_url }} 1600w"
              sizes="(min-width: 900px) 55vw, 100vw"
              width="1600"
              height="1073"
              loading="lazy"
              alt="{{ section.settings.head_alt | escape }}"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign link = block.settings.link
      if block.settings.product != blank
        assign link = block.settings.product.url
      endif
      case block.settings.bundled
        when 'shift-espresso'
          assign focal = '72% 50%'
        when 'travel-checker'
          assign focal = '30% 50%'
        when 'street-cherry-pop'
          assign focal = '64% 50%'
        when 'rest-daisy'
          assign focal = '32% 50%'
        else
          assign focal = '66% 50%'
      endcase
    -%}
    <article class="story story--{{ block.settings.align }}" data-parallax {{ block.shopify_attributes }}>
      <div class="story__media" data-parallax-media>
        {%- if block.settings.image != blank -%}
          {%- assign focal_style = block.settings.image.presentation.focal_point | prepend: 'object-position: ' -%}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              loading: 'lazy',
              alt: block.settings.image.alt,
              style: focal_style
          }}
        {%- elsif block.settings.bundled != 'none' -%}
          {%- assign md = 'story-' | append: block.settings.bundled | append: '-md.webp' -%}
          {%- assign lg = 'story-' | append: block.settings.bundled | append: '.webp' -%}
          <img
            src="{{ lg | asset_url }}"
            srcset="{{ md | asset_url }} 1400w, {{ lg | asset_url }} 2400w"
            sizes="100vw"
            width="2400"
            height="1340"
            loading="lazy"
            alt="{{ block.settings.alt | escape }}"
            style="object-position: {{ focal }};"
          >
        {%- endif -%}
      </div>
      <div class="story__scrim" aria-hidden="true"></div>
      <div class="container story__inner">
        <div class="story__copy" data-reveal>
          {%- if block.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h3 class="h1 story__heading">{{ block.settings.heading | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="story__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if link != blank and block.settings.link_label != blank -%}
            <a class="btn btn--light" href="{{ link }}">
              {{- block.settings.link_label | escape -}}
              {% render 'icon', name: 'arrow-right', size: 18 %}
            </a>
          {%- endif -%}
        </div>
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Parallax stories",
  "class": "section-stories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where they earn their keep" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave the eyebrow, heading and intro blank, with no intro photo, to start straight on the story panels.",
      "default": "Everyday compression for everyday legs."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Designed for tired, heavy or fatigued legs, including during long days standing, sitting or travelling."
    },
    { "type": "image_picker", "id": "head_image", "label": "Intro photo", "info": "Shown beside the intro. Landscape works best." },
    {
      "type": "select",
      "id": "head_bundled",
      "label": "Bundled intro photo (used when no photo is uploaded)",
      "options": [
        { "value": "duo", "label": "Nurse and runner, back to back" },
        { "value": "team", "label": "Nurse, flight attendant and office worker" },
        { "value": "none", "label": "None" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "head_alt",
      "label": "Intro photo description",
      "info": "Alt text for the bundled photo, and for an uploaded photo that has none.",
      "default": "A nurse in Espresso and a runner in Black knee-high compression socks, standing back to back and smiling with arms folded"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Landscape, at least 2400px wide. Leave room on one side for text." },
        {
          "type": "select",
          "id": "bundled",
          "label": "Bundled photo (used when no photo is uploaded)",
          "options": [
            { "value": "shift-espresso", "label": "Nurse in Espresso" },
            { "value": "travel-checker", "label": "Traveller in Checker" },
            { "value": "street-cherry-pop", "label": "Street style in Cherry Pop" },
            { "value": "rest-daisy", "label": "Rest day in Daisy" },
            { "value": "run-black", "label": "Dawn run in Black" },
            { "value": "none", "label": "None" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "alt", "label": "Bundled photo description", "info": "Alt text for the bundled photo." },
        {
          "type": "select",
          "id": "align",
          "label": "Text side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Twelve hours on your feet" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Button label" },
        { "type": "product", "id": "product", "label": "Link to product" },
        { "type": "url", "id": "link", "label": "Or link to page" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Parallax stories",
      "blocks": [
        { "type": "story", "settings": { "bundled": "shift-espresso", "align": "left", "heading": "Twelve hours on your feet" } }
      ]
    }
  ]
}
{% endschema %}
