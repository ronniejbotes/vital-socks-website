<section class="newsletter section tone-royal" aria-labelledby="NewsletterHeading-{{ section.id }}">
  {% render 'ribbons' %}
  <div class="container newsletter__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="h2" id="NewsletterHeading-{{ section.id }}" data-reveal>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="lede" style="margin-inline: auto;">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'sections.newsletter.email' | t }}</label>
        <input
          class="input"
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ 'sections.newsletter.email' | t }}"
          {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
        >
        <button class="btn btn--ink" type="submit">{{ 'sections.newsletter.subscribe' | t }}</button>
        {%- if form.errors -%}
          <p class="form-message form-message--error" id="NewsletterError-{{ section.id }}" role="alert">{{ 'sections.newsletter.error' | t }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.small_print != blank -%}
      <p class="newsletter__small">{% render 'policy-links', text: section.settings.small_print, privacy_link: true %}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New prints" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First dibs on the next drop" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One email when a new print lands, plus the odd fitting tip. Nothing else."
    },
    {
      "type": "text",
      "id": "small_print",
      "label": "Privacy notice",
      "info": "Shown under the form, followed by a link to the privacy policy when it exists.",
      "default": "We'll only use your email to send you Vital Socks news. Unsubscribe any time."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
