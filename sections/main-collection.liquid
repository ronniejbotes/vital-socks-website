{%- comment -%}
  Collection page. Sorting uses Shopify's sort_by parameter; the default
  robots.txt already keeps sorted URLs out of search results.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
  <div class="page-hero container">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
      <ol role="list">
        <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
        <li aria-current="page">{{ collection.title | escape }}</li>
      </ol>
    </nav>
    <h1 class="h1 page-hero__title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="lede page-hero__text rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <div class="container section--tight" style="padding-top: 0;">
    <div class="toolbar">
      <p>{{ 'sections.collection.product_count' | t: count: collection.products_count }}</p>
      {%- if section.settings.show_sort -%}
        <form class="toolbar__sort" method="get" data-sort-form>
          <label for="SortBy-{{ section.id }}">{{ 'sections.collection.sort_by' | t }}</label>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <select id="SortBy-{{ section.id }}" name="sort_by" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
          <noscript><button class="btn btn--ghost" type="submit">{{ 'sections.collection.sort_by' | t }}</button></noscript>
        </form>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list" style="--cols: {{ section.settings.columns }};" data-stagger>
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product, index: forloop.index0, eager: forloop.first %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="empty-state">{{ 'sections.collection.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}
