<!doctype html>
<html class="no-js" lang="en-ZA">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/png" href="{{ 'favicon-32.png' | asset_url }}">
    <title>{{ shop.name }}</title>
    {%- if shop.password_message != blank -%}
      <meta name="description" content="{{ shop.password_message | strip_html | escape }}">
    {%- endif -%}
    <style>
      @font-face { font-family: 'Anton'; src: url('{{ 'anton-latin.woff2' | asset_url }}') format('woff2'); font-display: swap; }
      @font-face { font-family: 'Inter'; src: url('{{ 'inter-latin-var.woff2' | asset_url }}') format('woff2'); font-weight: 400 700; font-display: swap; }
      :root {
        --ink: {{ settings.color_ink }};
        --ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
        --royal: {{ settings.color_royal }};
        --sky: {{ settings.color_sky }};
        --ice: {{ settings.color_ice }};
        --frost: {{ settings.color_frost }};
        --paper: {{ settings.color_paper }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
