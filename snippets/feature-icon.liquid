{%- comment -%}
  Product feature icons: a knee-high sock (toe pointing left, like the
  product renders) with a detail in the logo's blues. Decorative only.
  Usage: {% render 'feature-icon', name: 'graduated' %}
  Names: graduated, long-days, ankle, fabric, orthotist, travel.
{%- endcomment -%}
<svg class="feature-icon" viewBox="0 0 64 64" width="56" height="56" aria-hidden="true" focusable="false">
  <path class="fi-sock" d="M22 5h15v29c0 4 1.4 7.2 4.4 10.1 3.8 3.7 4.7 7.6 2.3 10.4-1.6 1.9-4 2.5-7.1 2.5H13.2c-4.4 0-6.9-2.2-6.9-5.2 0-3 2.4-4.8 6.5-6.4 6.1-2.4 9.2-5.6 9.2-10.9V5z"/>
  <path class="fi-cuff" d="M22 5h15v6H22z"/>
  {%- case name -%}
    {%- when 'graduated' -%}
      <path class="fi-band fi-band--ice" d="M22 18.5c5 1.6 10 1.6 15 0"/>
      <path class="fi-band fi-band--sky" d="M22 26.5c5 1.8 10 1.8 15 0"/>
      <path class="fi-band fi-band--royal" d="M22.4 35c5.2 2.2 10.4 2.2 15.2-.6"/>
    {%- when 'long-days' -%}
      <circle class="fi-badge" cx="50" cy="15" r="10"/>
      <path class="fi-mark" d="M50 9.5V15l3.6 2.4"/>
    {%- when 'ankle' -%}
      <ellipse class="fi-tape" cx="30" cy="38.5" rx="10.5" ry="3.4"/>
      <path class="fi-band fi-band--royal" d="M49 30v14M46.5 32.5 49 30l2.5 2.5M46.5 41.5 49 44l2.5-2.5"/>
    {%- when 'fabric' -%}
      <path class="fi-rib" d="M26 14v17M29.5 14v18M33 14v17"/>
      <circle class="fi-sun" cx="51" cy="12" r="4"/>
      <path class="fi-ray" d="M51 3.5v2.2M51 18.3v2.2M42.5 12h2.2M57.3 12h2.2M45 6l1.5 1.5M55.5 16.5 57 18M57 6l-1.5 1.5M46.5 16.5 45 18"/>
      <path class="fi-snow" d="M51 27v12M45.8 30l10.4 6M56.2 30l-10.4 6"/>
    {%- when 'orthotist' -%}
      <circle class="fi-badge fi-badge--solid" cx="50" cy="15" r="10"/>
      <path class="fi-check" d="m45.5 15.3 3.1 3.1 6-6.3"/>
    {%- when 'travel' -%}
      <path class="fi-plane" d="M44 16.5 58 9.8c1.6-.8 3 1.1 1.7 2.4L49.2 22.6l1.2 8.1-2.6 1.5-3.5-7-5.5 2.8-.4 3.4-2 1.1-.7-5.6-4.4-3.3 2-1.1 3.2.9 5.4-3.1z"/>
  {%- endcase -%}
</svg>
