{%- comment -%}
  Title, description, robots, Open Graph and Twitter tags.
  Titles and descriptions come from each resource's "Search engine listing"
  fields in the Shopify admin, falling back to its title and content.
  The " – {shop name}" suffix is added only when the whole title still fits
  in 60 characters, and never twice.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif

  assign noindex = false
  case request.page_type
    when 'search', 'cart', 'password', 'gift_card', 'captcha', '404'
      assign noindex = true
  endcase
  if current_tags
    assign noindex = true
  endif

  assign title_len = page_title | size
  assign title_max = shop.name | size | plus: 3
  assign title_max = 60 | minus: title_max

  assign founder_article = false
  if request.page_type == 'article' and settings.founder_name != blank and article.author contains settings.founder_name
    assign founder_article = true
  endif
  assign founder_profile = settings.founder_profile_url | default: settings.founder_url
-%}
<title>
  {{- page_title -}}
  {%- if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name or title_len > title_max %} &ndash; {{ shop.name }}{% endunless -%}
</title>
{%- if page_description != blank %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}
{%- if noindex %}
  <meta name="robots" content="noindex, follow">
{%- else %}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="en_ZA">
{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- else %}
  <meta property="og:image" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ shop.name | escape }}">
{%- endif %}
{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- if request.page_type == 'article' %}
  {%- if article.published_at %}
    <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- endif %}
  {%- comment -%}
    Modified time comes only from the date metafield custom.last_updated,
    set by hand when a post is actually revised. article.updated_at is not
    used because it changes on every save.
  {%- endcomment -%}
  {%- if article.metafields.custom.last_updated != blank %}
    <meta property="article:modified_time" content="{{ article.metafields.custom.last_updated.value | date: '%Y-%m-%d' }}">
  {%- endif %}
  {%- if founder_article and founder_profile != blank %}
    <meta property="article:author" content="{{ founder_profile | escape }}">
  {%- endif %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
