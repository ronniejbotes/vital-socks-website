{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'arrow-right', size: 24 %}
  Stroke icons follow the lucide geometry (24px grid, 2px stroke).
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
  assign sw = stroke | default: 2
-%}
{%- case name -%}
  {%- when 'arrow-left' -%}
    <svg class="icon icon--{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
